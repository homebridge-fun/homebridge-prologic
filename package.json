    "homebridge": ">=2.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "homebridge": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "homebridge": ">=2.0.0"
  }
}
