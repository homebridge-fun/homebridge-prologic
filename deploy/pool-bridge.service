[Unit]
Description=RS-485 smart-bridge daemon (AquaLogic pad Pi)
Documentation=https://github.com/homebridge-fun/homebridge-prologic
# The daemon binds the tailnet IP, so tailscaled must be up first. It resolves
# that address itself at startup (RS485_BRIDGE_LISTEN=tailnet:8899) and waits
# for the interface, so ordering here is an optimisation rather than a
# correctness requirement. It also exits non-zero if the address later leaves
# the interface -- a node renumber -- and Restart=on-failure rebinds it.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=greg
# Token + bind address + serial device live here (created by install-pad.sh,
# NOT committed — it holds the shared secret).
EnvironmentFile=/etc/pool-bridge.env
# RS485_BRIDGE_SCRIPT is an absolute path written by install-pad.sh — %h is NOT
# used because systemd resolves it to /root for system services regardless of
# User=, which points at the wrong checkout.
ExecStart=/usr/bin/python3 ${RS485_BRIDGE_SCRIPT} \
    --port ${RS485_BRIDGE_PORT} --listen ${RS485_BRIDGE_LISTEN}
Restart=on-failure
RestartSec=5

# Resource cap — the daemon is lightweight (http.server + pyserial + aqualogic,
# ~40MB steady). On a 512MB Pi a runaway here must never be allowed to thrash
# the whole system into a swap-death freeze. MemoryHigh throttles + reclaims
# first (soft, gives it a chance to recover); MemoryMax is the hard cgroup
# ceiling — past it the kernel OOM-kills ONLY this service's cgroup, the SIGKILL
# is a non-zero exit, and Restart=on-failure brings it straight back. OOMPolicy=
# kill makes the whole cgroup die together (no half-dead child threads).
MemoryHigh=96M
MemoryMax=150M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
